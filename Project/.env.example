# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Free AI mode: Gemini's eligible free-tier model. If the key is blank or the
# provider is temporarily unavailable, the app automatically uses local AI.
AI_PROVIDER=gemini
ENABLE_AI=true
AI_TIMEOUT_SECONDS=20

# Gemini API key from Google AI Studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenRouter free-router alternative
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=http://127.0.0.1:8000
OPENROUTER_TITLE=CareerAI Resume Interview

# Password reset email. Fill the Gmail values to send OTPs to real inboxes.
# With both credentials blank, the app automatically uses the free console
# backend and prints the OTP in the Django server terminal for local testing.
# Gmail requires a 16-character App Password, not your normal login password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
PASSWORD_RESET_OTP_EXPIRY_SECONDS=600
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=30
# Optional when deploying on Linux without a Devanagari font:
# REPORT_PDF_FONT_PATH=/absolute/path/to/NotoSansDevanagari-Regular.ttf

# Upload limit
RESUME_MAX_SIZE=10485760
