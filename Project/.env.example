# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Free AI mode: OpenRouter's free-model router. If the key is blank or the
# free model is temporarily unavailable, the app automatically uses local AI.
AI_PROVIDER=openrouter
ENABLE_AI=true
AI_TIMEOUT_SECONDS=20

# Free Gemini alternative (switch AI_PROVIDER to gemini to use this instead)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter free router (do not use a paid model name here)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openrouter/free
OPENROUTER_HTTP_REFERER=http://127.0.0.1:8000
OPENROUTER_TITLE=CareerAI Resume Interview

# Upload limit
RESUME_MAX_SIZE=10485760
